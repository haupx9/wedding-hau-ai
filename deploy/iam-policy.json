{
  "Comment": "Quyen toi thieu cho IAM user chay tren may Lightsail. Doi 3 cho: SO_TAI_KHOAN, VUNG, TEN-BUCKET.",
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "GhiVaDocHaiBangDynamoDB",
      "Effect": "Allow",
      "Action": [
        "dynamodb:PutItem",
        "dynamodb:GetItem",
        "dynamodb:Scan",
        "dynamodb:DescribeTable"
      ],
      "Resource": [
        "arn:aws:dynamodb:VUNG:SO_TAI_KHOAN:table/wedding-responses",
        "arn:aws:dynamodb:VUNG:SO_TAI_KHOAN:table/wedding-guests"
      ]
    },
    {
      "Sid": "GhiMaQRVaoMotThuMucS3",
      "Effect": "Allow",
      "Action": ["s3:PutObject", "s3:GetObject", "s3:ListBucket"],
      "Resource": [
        "arn:aws:s3:::TEN-BUCKET",
        "arn:aws:s3:::TEN-BUCKET/qr/*"
      ]
    }
  ]
}
